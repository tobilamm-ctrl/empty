{
  "id": "./",
  "name": "LAMMping",
  "short_name": "LAMMping",
  "description": "Unser Reisetagebuch für den Minicamper",
  "lang": "de",
  "start_url": "./#/karte",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FBF6EC",
  "theme_color": "#FBF6EC",
  "categories": [
    "travel",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Ich bin hier …",
      "short_name": "Ich bin hier",
      "description": "Aktuellen Ort ins Tagebuch eintragen",
      "url": "./#/karte/hier",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Auto geparkt",
      "short_name": "Auto",
      "description": "Parkplatz merken oder Auto wiederfinden",
      "url": "./#/karte/auto",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Einkaufsliste",
      "short_name": "Einkauf",
      "url": "./#/listen/einkauf",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Highlight des Tages",
      "short_name": "Highlight",
      "url": "./#/tagebuch/highlight",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./teilen-ziel/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "fotos",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
