rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nur ihr zwei dürft lesen und schreiben. Die beiden Adressen anpassen.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['erste@adresse.de', 'zweite@adresse.de'];
    }
  }
}
