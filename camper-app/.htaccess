AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  # Der Service Worker muss immer frisch geladen werden, sonst kommen Updates nicht an
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
  # App-Dateien immer beim Server nachfragen (kostet nur eine kurze Rückfrage), damit Updates sofort ankommen
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
